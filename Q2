
def verify_otp_while():
    correct_otp = "1234"
    attempts = 0

    while attempts < 3:
        user_input = input("Enter OTP: ").strip()

        if user_input == "":
            print("Blank entry detected. Not counted.")
            continue

        if user_input == correct_otp:
            print("OTP Verified Successfully!")
            return

        attempts += 1

        print("Incorrect OTP. Attempts remaining:", 3 - attempts)

    print("Account LOCKED for 30 minutes.")


def verify_otp_for():
    correct_otp = "1234"
    attempts = 0

    entries = ["1111", "", "2222", "3333"]

    for user_input in entries:

        user_input = user_input.strip()

        if user_input == "":
            print("Blank entry detected. Not counted.")
            continue

        if user_input == correct_otp:
            print("OTP Verified Successfully!")
            return

        attempts += 1

        print("Incorrect OTP. Attempts remaining:", 3 - attempts)

        if attempts == 3:
            print("Account LOCKED for 30 minutes.")
            break


print("WHILE LOOP:")
verify_otp_while()

print("\nFOR LOOP:")
verify_otp_for()
